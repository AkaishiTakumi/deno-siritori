{
    "deno.cacheOnSave": true,
    "deno.codeLens.implementations": true,
    "deno.codeLens.references": true,
    "deno.codeLens.referencesAllFunctions": true,
    "deno.codeLens.test": true,
    "deno.enable": true,
    "deno.envFile": "./.env",
    "deno.internalDebug": false,
    "deno.internalInspect": "127.0.0.1:9222",
    "deno.lint": false,
    "deno.logFile": true,
    "deno.organizeImports.enabled": true,
    "deno.suggest.imports.autoDiscover": true,
    "deno.suggest.imports.hosts": {
        "https://deno.land": true
    },
    "deno.symbols.document.enabled": true,
    "deno.symbols.workspace.enabled": true,
    "deno.testing.args": [
        "--allow-all",
        "--no-check"
    ],
    "deno.trace.server": "off",
    "deno.unstable": []
}
