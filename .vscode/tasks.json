{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Deno: Build Watch",
            "type": "shell",
            "command": "deno task build:watch",
            "isBackground": true,
            "problemMatcher": {
                "owner": "typescript",
                "fileLocation": "relative",
                "pattern": {
                    "regexp": "^.*$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "watching|building|built",
                    "endsPattern": "built in|built|Watching for changes"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        }
    ]
}
