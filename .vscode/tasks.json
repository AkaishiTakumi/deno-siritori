{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Vite: Build Watch",
            "type": "shell",
            "command": "npx vite build --watch",
            "isBackground": true,
            "problemMatcher": {
                "owner": "typescript",
                "fileLocation": "relative",
                "pattern": {
                    "regexp": "^.*$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "watching|building|built",
                    "endsPattern": "built in|built|Watching for changes"
                }
            }
        },
        {
            "label": "Build",
            "type": "shell",
            "command": "npm run build",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Deploy",
            "type": "shell",
            "command": "npm run deploy"
        }
    ]
}
