{
    "version": "0.2.0",
    "configurations": [
        {
            "request": "launch",
            "name": "Deno: Serve & Watch",
            "type": "node",
            "runtimeExecutable": "deno",
            "runtimeArgs": [
                "run",
                "-A",
                "--inspect"
            ],
            "program": "${workspaceFolder}/main.ts",
            "attachSimplePort": 9229,
            "preLaunchTask": "Deno: Build Watch"
        }
    ]
}
