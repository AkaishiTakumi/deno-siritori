{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Wrangler Dev",
            "command": "npx wrangler dev",
            "type": "node-terminal",
            "request": "launch",
            "preLaunchTask": "Vite: Build Watch"
        },
        {
            "name": "Attach to Worker",
            "type": "node",
            "request": "attach",
            "port": 9229,
            "cwd": "/",
            "resolveSourceMapLocations": null,
            "attachExistingChildren": false,
            "autoAttachChildProcesses": false,
            "sourceMaps": true
        }
    ]
}
